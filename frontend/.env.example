# Endereço do contrato ERC20 deployado
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Nome da rede (ex: "Local Hardhat", "Sepolia Testnet")
NEXT_PUBLIC_NETWORK_NAME=Local Hardhat

# Chain ID da rede
NEXT_PUBLIC_CHAIN_ID=31337

# URL base da aplicação (para webhooks)
NEXT_PUBLIC_URL=http://localhost:3000

# ===========================================
# PagBank (PagSeguro) - Pagamentos em BRL
# ===========================================
# Crie uma conta em https://pagseguro.uol.com.br
# Vá em: Minha Conta > Integrações > API
# Gere um token de produção (começa com "SEU_")
# Deixe VAZIO para usar o modo demo
PAGBANK_TOKEN=

# ===========================================
# Bipa - Pagamentos em Bitcoin/Lightning
# ===========================================
# Crie uma conta em https://bipa.app
# Vá em: API > Gerar chave de API
# Deixe VAZIO para usar o modo demo
BIPA_API_KEY=
