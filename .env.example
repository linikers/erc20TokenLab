# Sepolia Testnet (get RPC URL from Alchemy/Infura)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Wallet private key (with test ETH on Sepolia)
PRIVATE_KEY=0x...

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=...

# ---------------------------------------------------------------
# Checkout (frontend/)
# ---------------------------------------------------------------

# URL pública do site — usada nas URLs de webhook e de acesso.
NEXT_PUBLIC_URL=https://ecr20ttk.vercel.app

# Painel do admin (aprovacao manual do Pix manual).
ADMIN_PASSWORD=

# --- Mercado Pago (Pix automático) ---
# Access Token da aplicação (Mercado Pago → Suas integrações → Credenciais).
# Produção: ative as credenciais de produção na aplicação (ramo + URL do site + termos).
# Teste: esta API NÃO aceita credenciais de teste — use um usuário de teste com
# credenciais de produção, e o e-mail do pagador precisa conter @testuser.com.
MP_ACCESS_TOKEN=

# Base da API do Mercado Pago (default: https://api.mercadopago.com).
MP_BASE_URL=https://api.mercadopago.com

# O Pix manual (chave estática em `src/lib/pix.ts`) não usa variável: é o fallback
# quando o Mercado Pago não está configurado ou recusa a cobrança.
