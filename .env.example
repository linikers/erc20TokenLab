# Sepolia Testnet (get RPC URL from Alchemy/Infura)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Wallet private key (with test ETH on Sepolia)
PRIVATE_KEY=0x...

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=...

# ---------------------------------------------------------------
# Checkout (frontend/)
# ---------------------------------------------------------------

# URL pública do site — usada na notification_url do webhook do PagBank.
NEXT_PUBLIC_URL=https://ecr20ttk.vercel.app

# Token da API de Pedidos do PagBank.
#   produção: desktop PagBank -> Vendas -> Integracoes -> Gerar Token
#   sandbox:  portaldev.pagbank.com.br -> aba Tokens
# Sem ele, /api/pagbank/checkout responde 503 e o site cai no PIX manual.
PAGBANK_TOKEN=

# Base da API de Pedidos. Produção: https://api.pagseguro.com
# (default do código: https://sandbox.api.pagseguro.com)
PAGBANK_BASE_URL=https://api.pagseguro.com

# Validade do QR PIX em minutos (default 60).
PAGBANK_PIX_MINUTOS=60

# Painel do admin (aprovacao manual do PIX estatico).
ADMIN_PASSWORD=
